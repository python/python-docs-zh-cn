msgid ""
"@dataclass\n"
"class Circle:\n"
"   radius: float\n"
"\n"
"   @property\n"
"   def area(self) -> float:\n"
"      return pi * self.radius**2\n"
"\n"
"class Container:\n"
"   def __init__(self, inner: Circle) -> None:\n"
"      self.inner = inner\n"
"\n"
"circle = Circle(radius=4.0)\n"
"container = Container(circle)\n"
"print(container.area)"
msgstr ""
"@dataclass\n"
"class Circle:\n"
"   radius: float\n"
"\n"
"   @property\n"
"   def area(self) -> float:\n"
"      return pi * self.radius**2\n"
"\n"
"class Container:\n"
"   def __init__(self, inner: Circle) -> None:\n"
"      self.inner = inner\n"
"\n"
"circle = Circle(radius=4.0)\n"
"container = Container(circle)\n"
"print(container.area)"

