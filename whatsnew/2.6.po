msgstr "可以使用 ``@abstractproperty`` 装饰器声明抽象数据属性::"

#: ../../whatsnew/2.6.rst:1295
msgid ""
"from abc import abstractproperty\n"
"...\n"
"\n"
"@abstractproperty\n"
"def readonly(self):\n"
"   return self._x"
msgstr ""
"from abc import abstractproperty\n"
"...\n"
"\n"
"@abstractproperty\n"
"def readonly(self):\n"
"   return self._x"

#: ../../whatsnew/2.6.rst:1302
msgid "Subclasses must then define a ``readonly`` property."
msgstr "子类必须定义一个 ``readonly`` 属性。"

