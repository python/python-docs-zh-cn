#: ../NEWS:35749
msgid "Python 3.8.0 alpha 4"
msgstr "Python 3.8.0 alpha 4"

#: ../NEWS:35751
msgid "*Release date: 2019-05-06*"
msgstr "*发布日期: 2019-05-06*"

#: ../NEWS:35756
msgid ""
