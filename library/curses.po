#: ../../library/curses.rst:1560
msgid ""
"Several constants are available to extract corresponding attributes returned"
" by some methods."
msgstr "有几个常量可用于提取某些方法返回的相应属性。"

#: ../../library/curses.rst:1564
msgid "Bit-mask"
msgstr "位掩码"

#: ../../library/curses.rst:1566
msgid "Bit-mask to extract attributes"
msgstr "用于提取属性的位掩码"

#: ../../library/curses.rst:1569
msgid "Bit-mask to extract a character"
msgstr "用于提取字符的位掩码"

#: ../../library/curses.rst:1572
msgid "Bit-mask to extract color-pair field information"
msgstr "用于提取颜色对字段信息的位掩码"

#: ../../library/curses.rst:1578
msgid ""
"Keys are referred to by integer constants with names starting with  "
"``KEY_``. The exact keycaps available are system dependent."
msgstr "键由名称以 ``KEY_`` 开头的整数常量引用。确切的可用键取决于系统。"

#: ../../library/curses.rst:1584
msgid "Key constant"
msgstr "键常量"

#: ../../library/curses.rst:1584
msgid "Key"
msgstr "键"

#: ../../library/curses.rst:1586
msgid "Minimum key value"
msgstr "最小键值"

#: ../../library/curses.rst:1588
msgid "Break key (unreliable)"
msgstr "中断键（不可靠）"

#: ../../library/curses.rst:1590
msgid "Down-arrow"
msgstr "向下箭头"

#: ../../library/curses.rst:1592
msgid "Up-arrow"
msgstr "向上箭头"

#: ../../library/curses.rst:1594
msgid "Left-arrow"
msgstr "向左箭头"

#: ../../library/curses.rst:1596
msgid "Right-arrow"
msgstr "向右箭头"

#: ../../library/curses.rst:1598
msgid "Home key (upward+left arrow)"
msgstr "Home 键 (上+左箭头)"

#: ../../library/curses.rst:1600
msgid "Backspace (unreliable)"
msgstr "退格（不可靠）"

#: ../../library/curses.rst:1602
msgid "Function keys.  Up to 64 function keys are supported."
msgstr "功能键。 支持至多 64 个功能键。"

#: ../../library/curses.rst:1605
msgid "Value of function key *n*"
