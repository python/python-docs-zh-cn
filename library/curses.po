msgid "Top"
msgstr "顶部"

#: ../../library/curses.rst:889 ../../library/curses.rst:891
msgid ":const:`ACS_HLINE`"
msgstr ":const:`ACS_HLINE`"

#: ../../library/curses.rst:891
msgid "*bs*"
msgstr "*bs*"

#: ../../library/curses.rst:891
msgid "Bottom"
msgstr "底部"

#: ../../library/curses.rst:893
