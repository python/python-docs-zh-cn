"\n"
"async def agenfn():\n"
"    try:\n"
"        yield 10\n"
"    finally:\n"
"        await asyncio.sleep(0)\n"
"\n"
"\n"
"with asyncio.Runner() as runner:\n"
"    agen = agenfn()\n"
"    print(runner.run(anext(agen)))\n"
"    del agen"

